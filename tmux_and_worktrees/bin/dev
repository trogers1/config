#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
    cat <<'EOF'
Usage: dev <command> [arguments]
       dev --list

Manage tmux development sessions and git worktrees. Run this from a project
checkout; commands that create or manage worktrees require a Git repository.

Commands:
  --list                    List open/saved sessions and this repo's worktrees.
  switch                    Fuzzy-pick OPEN sessions by default (requires fzf).
                              Ctrl+A toggles OPEN / ALL sessions and worktrees,
                              preserving the search query (even with no OPEN).
                              OPEN reads live tmux metadata only. ALL discovers
                              on demand with a Loading indicator; no Git status
                              scans (use --list for clean/dirty details).
                              Uses a popup inside tmux; terminal otherwise.
                              Connect to open sessions, exactly resume one saved
                              session, or run dev new for an available worktree.
                              Esc/Ctrl-C cancels without changing sessions.
  new [launch options] [path]
                              Open or create a dev tmux session for a path.
  open [launch options] [path]
                              Alias for `dev new`.
  tree [launch options] <branch> [base]
                              Create or open a worktree and its dev session.
                              A new branch starts from [base], or the current
                              branch when omitted.
  tree init [branch]         Re-run a linked worktree's startup script.
  close [branch|path]        Close a dev tmux session, retaining its checkout.
  kill [branch|path] [--force] [--yes]
                              Remove a worktree, its session, and local branch.
  merge [branch|path] [target] [--keep]
                              Merge a worktree branch and clean it up.
  resume-all                 Recreate missing registered sessions detached,
                              resuming only their exact recorded agent chats.
  home                       Change this shell to the active session's root.
                              Requires the installed zsh shell integration.
  help                       Show this help.

Launch options (new, open, tree):
  --agent <name>             Select the configured agent for a new session.
  --prompt TEXT             Initial assignment for a fresh Pi or Claude session.
  --prompt-file PATH        UTF-8 assignment file; exclusive with --prompt.
  --agent-profile NAME      Pi-only pi-guard startup profile, with or without
                              a prompt. Requires an enabled unfiltered local
                              pi-guard package in Pi user settings.
                              Prompt/profile options fail for existing sessions
                              or unsupported configured launch commands.
  --stage-agent             Type the agent command without starting it.
  --no-attach               Never prompt or attach; print only the checkout path.

EOF
}

run_lifecycle_command() {
    # Leading help flags exit inside the command before any lifecycle work.
    # Do not require state-directory access just to read usage in a sandbox.
    case "${2:-}" in
        --help|-h) exec "$@" ;;
    esac
    exec python3 "$SCRIPT_DIR/lib/dev_registry.py" run "$@"
}

command_name="${1:-}"
case "$command_name" in
    --list)
        [ "$#" -eq 1 ] || { echo 'Usage: dev --list' >&2; exit 1; }
        source "$SCRIPT_DIR/lib/tmux_worktree.sh"
        source "$SCRIPT_DIR/lib/dev_inventory.sh"
        tmux_worktree_list_inventory
        ;;
    switch)
        shift
        case "${1:-}" in
            -h|--help) [ "$#" -eq 1 ] || { echo 'Usage: dev switch' >&2; exit 1; }; usage; exit 0 ;;
        esac
        [ "$#" -eq 0 ] || { echo 'Usage: dev switch' >&2; exit 1; }
        source "$SCRIPT_DIR/lib/tmux_worktree.sh"
        source "$SCRIPT_DIR/lib/dev_inventory.sh"
        tmux_worktree_switch_inventory
        ;;
    new)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dnew" "$@"
        ;;
    open)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dnew" "$@"
        ;;
    tree)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dtree" "$@"
        ;;
    close)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dclose" "$@"
        ;;
    kill)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dkill" "$@"
        ;;
    merge)
        shift
        run_lifecycle_command "$SCRIPT_DIR/lib/commands/dmerge" "$@"
        ;;
    _record-agent)
        shift
        exec python3 "$SCRIPT_DIR/lib/dev_registry.py" bind "$@"
        ;;
    resume-all)
        [ "$#" -eq 1 ] || { echo 'Usage: dev resume-all' >&2; exit 1; }
        run_lifecycle_command python3 "$SCRIPT_DIR/lib/dev_registry.py" resume-all
        ;;
    home)
        echo "dev home must be run from a shell with the dev shell integration loaded" >&2
        exit 1
        ;;
    help|-h|--help|"")
        usage
        ;;
    *)
        echo "Unknown dev command: $command_name" >&2
        usage >&2
        exit 1
        ;;
esac
