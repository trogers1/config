#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/../tmux_worktree.sh"

target=""
force="false"
assume_yes="false"

log() {
    printf "[dev kill] %s\n" "$*"
}

usage() {
    echo "Usage: dev kill [branch|path] [--force] [--yes]"
}

kill_sessions_for_worktree() {
    local wt_path="$1"
    local repo_name="$2"
    local branch="$3"
    local preferred_session_name=""

    if [ -n "$branch" ]; then
        preferred_session_name="$(tmux_worktree_preferred_worktree_session_name "$repo_name" "$branch")"
    fi
    tmux_worktree_kill_sessions_for_worktree_path "$wt_path" "$preferred_session_name" "$(tmux_worktree_current_session_name)" false || true
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --help|-h)
            usage
            exit 0
            ;;
        --force|-f)
            force="true"
            ;;
        --yes|-y)
            assume_yes="true"
            ;;
        --)
            shift
            if [ "$#" -gt 1 ] || { [ "$#" -eq 1 ] && [ -n "$target" ]; }; then
                usage
                exit 1
            fi
            target="${1:-$target}"
            break
            ;;
        -*)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;
        *)
            if [ -z "$target" ]; then
                target="$1"
            else
                usage
                exit 1
            fi
            ;;
    esac
    shift
done

tmux_worktree_require_git

current_wt_path="$(git rev-parse --show-toplevel 2>/dev/null || true)"
# With no target, act on the worktree this command runs in, which also covers
# detached worktrees that have no branch to name.
if [ -z "$target" ]; then
    tmux_worktree_require_git_repo
    target="$current_wt_path"
fi

repo_root="$(tmux_worktree_main_repo_root_for_target "$target")"
repo_name="$(basename "$repo_root")"

resolved="$(tmux_worktree_resolve_worktree "$repo_root" "$target")"
wt_path="${resolved%%$'\t'*}"
branch="${resolved#*$'\t'}"

case "$branch" in
    main|master|develop|staging)
        if [ "$force" != "true" ]; then
            echo "Refusing to close protected branch '$branch' without --force."
            exit 1
        fi
        ;;
esac

if [ "$(tmux_worktree_physical_path "$wt_path")" = "$(tmux_worktree_physical_path "$repo_root")" ]; then
    echo "Refusing to remove the main checkout: $wt_path"
    exit 1
fi

if [ "$force" != "true" ] && [ -n "$(git -C "$wt_path" status --porcelain)" ]; then
    echo "Worktree is dirty: $wt_path"
    echo "Commit/stash first, or rerun with --force."
    exit 1
fi

if [ "$force" != "true" ] && [ "$assume_yes" != "true" ] && [ -t 0 ]; then
    if [ -n "$branch" ]; then
        printf "Close worktree '%s' and delete local branch '%s'? [y/N] " "$wt_path" "$branch"
    else
        printf "Close detached worktree '%s'? [y/N] " "$wt_path"
    fi
    read -r answer
    case "$answer" in
        y|Y|yes|YES)
            ;;
        *)
            echo "Cancelled."
            exit 0
            ;;
    esac
fi

remove_args=(worktree remove)
branch_args=(branch -d)
if [ "$force" = "true" ]; then
    remove_args+=(--force)
    branch_args=(branch -D)
fi

tmux_worktree_registry check
git -C "$repo_root" "${remove_args[@]}" "$wt_path"
registry_failed=false
if ! tmux_worktree_registry forget "$wt_path"; then
    registry_failed=true
    echo "Removed $wt_path, but could not unregister it. Session/branch cleanup will continue; repair the registry and run dev close from the restored checkout to remove stale intent." >&2
fi

# Sessions are killed last because this command may be running inside one of
# them, so a failed branch delete is reported after they are gone.
branch_deleted=true
if [ -n "$branch" ] && ! git -C "$repo_root" "${branch_args[@]}" "$branch"; then
    branch_deleted=false
fi

if [ "$branch_deleted" = false ]; then
    echo "Removed worktree $wt_path but kept branch '$branch'; delete it with: git branch -D $branch" >&2
fi

if command -v tmux >/dev/null 2>&1; then
    kill_sessions_for_worktree "$wt_path" "$repo_name" "$branch"
fi

if [ "$branch_deleted" = false ] || [ "$registry_failed" = true ]; then
    exit 1
fi

label="${branch:-$wt_path}"
if [ "$current_wt_path" = "$wt_path" ]; then
    log "Closed current worktree '$label'. Open another session if needed."
else
    log "Closed worktree '$label'."
fi
