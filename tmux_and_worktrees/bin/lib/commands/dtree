#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$SCRIPT_DIR/../tmux_worktree.sh"

log() {
    printf "[dev tree] %s\n" "$*"
}

usage() {
    cat <<'EOF'
Usage: dev tree [--no-attach] [--agent <name>] [--stage-agent] [--] [branch] [base-branch]
       dev tree init [branch]

  --no-attach      Never prompt or attach. Create (or reuse) the worktree and
                   its tmux session, send all progress to stderr, and print only
                   the worktree path on stdout. Fails instead of prompting.
  --agent <name>   Agent for the session's agent window (from devConfig.jsonc
                   agents). Used only when a new session is created. An
                   agent the config cannot provide is a warning, and the agent
                   window opens as an empty shell.
  --stage-agent    Type the agent's command into its window without running
                   it, so it starts when you press Enter there.
EOF
}

default_primary_branch() {
    local remote_head=""

    remote_head="$(git -C "$repo_root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [ -n "$remote_head" ]; then
        printf '%s\n' "${remote_head#origin/}"
    elif git -C "$repo_root" show-ref --verify --quiet refs/heads/main; then
        printf '%s\n' "main"
    elif git -C "$repo_root" show-ref --verify --quiet refs/heads/master; then
        printf '%s\n' "master"
    else
        printf '%s\n' ""
    fi
}

prompt_to_check_remote_branch() {
    local remote_name="$1"
    local response=""

    printf '[dev tree] No local branch named %s. Fetch %s and look for %s/%s? [y/N] (N creates it from %s) ' "$branch" "$remote_name" "$remote_name" "$branch" "$base_branch" >&2

    if ! read -r response </dev/tty; then
        printf '\n[dev tree] Cannot read a confirmation; creating the branch from %s.\n' "$base_branch" >&2
        return 1
    fi

    case "$response" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

prompt_to_convert_main_checkout() {
    local primary_branch="$1"
    local response=""

    printf '\n[dev tree] %s is already checked out in the primary checkout: %s\n' "$branch" "$repo_root" >&2
    printf '[dev tree] Turn it into a worktree at %s? The primary checkout will switch to %s. [y/N] ' "$default_wt_path" "$primary_branch" >&2

    if ! read -r response </dev/tty; then
        printf '\n[dev tree] Cannot read a confirmation; leaving the branch in the primary checkout.\n' >&2
        return 1
    fi

    case "$response" in
        y|Y|yes|YES|Yes)
            return 0
            ;;
        *)
            printf '[dev tree] Leaving the branch in the primary checkout.\n' >&2
            return 1
            ;;
    esac
}

run_startup_script() {
    local repo_root="$1"
    local wt_path="$2"
    local startup_script="$SCRIPT_DIR/../worktree-init-example.sh"

    # An empty placeholder should not suppress the bundled baseline setup.
    # Use a non-empty project script only when it actually supplies setup.
    if [ -s "$repo_root/.worktree-init.sh" ]; then
        startup_script="$repo_root/.worktree-init.sh"
    elif [ -s "$repo_root/scripts/worktree-init.sh" ]; then
        startup_script="$repo_root/scripts/worktree-init.sh"
    fi

    log "Running startup script: $startup_script"
    # Under --no-attach, fd 3 is the caller's stdout. Close it so a process the
    # script leaves in the background cannot hold the caller's pipe open, and
    # give the script no stdin to block on.
    (cd "$wt_path" && REPO_ROOT="$repo_root" WORKTREE_PATH="$wt_path" tmux_worktree_registry initialize bash "$startup_script") 3>&- </dev/null
}

if [ "${1:-}" = "init" ]; then
    if [ "$#" -gt 2 ]; then
        echo "Usage: dev tree init [branch]" >&2
        exit 1
    fi

    tmux_worktree_require_git
    tmux_worktree_require_git_repo
    repo_root="$(tmux_worktree_main_repo_root)"
    branch="${2:-$(tmux_worktree_git_current_branch)}"
    if [ -z "$branch" ]; then
        echo "[dev tree] Cannot determine a branch. Use: dev tree init <branch>" >&2
        exit 1
    fi

    wt_path="$(tmux_worktree_path_for_branch "$repo_root" "$branch")"
    if [ -z "$wt_path" ] || [ "$wt_path" = "$repo_root" ]; then
        echo "[dev tree] No linked worktree found for branch: $branch" >&2
        exit 1
    fi

    run_startup_script "$repo_root" "$wt_path"
    exit 0
fi

no_attach=false
agent=""
stage_agent=false
positionals=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --no-attach)
            no_attach=true
            shift
            ;;
        --agent)
            if [ "$#" -lt 2 ] || [ -z "$2" ]; then
                echo "[dev tree] Missing value for --agent" >&2
                exit 1
            fi
            agent="$2"
            shift 2
            ;;
        --stage-agent)
            stage_agent=true
            shift
            ;;
        --)
            shift
            positionals+=("$@")
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            echo "[dev tree] Unknown option: $1" >&2
            usage >&2
            exit 1
            ;;
        *)
            positionals+=("$1")
            shift
            ;;
    esac
done

if [ "${#positionals[@]}" -gt 2 ]; then
    usage >&2
    exit 1
fi
branch="${positionals[0]:-}"
base_branch="${positionals[1]:-}"

# In non-interactive mode stdout carries only the worktree path, so callers
# such as Claude Code's WorktreeCreate hook can read it. Everything else,
# including git, tmux, and startup-script output, goes to stderr.
if [ "$no_attach" = true ]; then
    exec 3>&1 1>&2
fi

finish() {
    local session_name="$1"

    tmux_worktree_registry commit-workspace "$workspace_decision" "$wt_path"
    completed=true
    if [ "$no_attach" = true ]; then
        printf '%s\n' "$wt_path" >&3
    else
        tmux_worktree_attach_or_switch "$session_name"
    fi
}

tmux_worktree_require_git
tmux_worktree_require_tmux
tmux_worktree_require_git_repo

current_branch="$(tmux_worktree_git_current_branch)"

if [ -z "$branch" ]; then
    if [ -n "$current_branch" ]; then
        branch="$current_branch"
    else
        usage >&2
        exit 1
    fi
fi

if [ -z "$base_branch" ]; then
    base_branch="$current_branch"
    if [ -z "$base_branch" ]; then
        base_branch="main"
    fi
fi

repo_root="$(tmux_worktree_main_repo_root)"
repo_name="$(basename "$repo_root")"
worktree_root="$(tmux_worktree_default_root "$repo_root")"
default_wt_path="$(tmux_worktree_default_path "$repo_root" "$branch")"

existing_wt_path="$(tmux_worktree_path_for_branch "$repo_root" "$branch")"
created_worktree=false
created_branch=false
completed=false
trap '
    status=$?
    if [ "$completed" = false ] && [ "$created_worktree" = true ]; then
        git -C "$repo_root" worktree remove --force "$wt_path" || { echo "Failed to roll back new worktree: $wt_path" >&2; status=1; }
        if [ "$created_branch" = true ]; then
            git -C "$repo_root" branch -D "$branch" || { echo "Failed to roll back new branch: $branch" >&2; status=1; }
        fi
    fi
    exit "$status"
' EXIT
# Window lines for the new session. A new worktree resolves them before it is
# created, so an invalid config leaves nothing behind.
windows=""
session_agent="$agent"

# --no-attach callers expect a linked worktree, so never hand them the primary
# checkout, whichever worktree this runs from.
if [ "$no_attach" = true ] && [ -n "$existing_wt_path" ] &&
    [ "$(tmux_worktree_physical_path "$existing_wt_path")" = "$(tmux_worktree_physical_path "$repo_root")" ]; then
    echo "[dev tree] $branch is checked out in the primary checkout ($repo_root). --no-attach never moves it; run \`dev tree $branch\` interactively or check out another branch there first." >&2
    exit 1
fi

workspace_decision="$(tmux_worktree_registry prepare-workspace "branch $branch" "$no_attach")"

# A branch checked out in the primary checkout cannot also be added as a
# worktree. Offer to move the primary checkout to its default branch first.
if [ "$existing_wt_path" = "$repo_root" ] && [ "$current_branch" = "$branch" ]; then
    primary_branch="$(default_primary_branch)"

    if [ -z "$primary_branch" ] || [ "$primary_branch" = "$branch" ]; then
        echo "[dev tree] Cannot choose a primary branch. Set origin/HEAD or create main/master before rerunning." >&2
        exit 1
    fi

    if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
        echo "[dev tree] Cannot turn $branch into a worktree because the primary checkout has uncommitted changes. Commit or stash them first." >&2
        exit 1
    fi

    if prompt_to_convert_main_checkout "$primary_branch"; then
        main_session_name="$(tmux_worktree_find_session_for_worktree_path "$repo_root" || true)"
        git -C "$repo_root" checkout "$primary_branch"
        if [ -n "$main_session_name" ]; then
            tmux_worktree_set_session_metadata "$main_session_name" "$repo_root" "$primary_branch"
        fi
        existing_wt_path=""
    fi
fi

if [ -n "$existing_wt_path" ]; then
    wt_path="$existing_wt_path"
else
    wt_path="$default_wt_path"
    mkdir -p "$worktree_root"

    if [ -d "$wt_path" ]; then
        if [ "$no_attach" = true ]; then
            echo "[dev tree] $wt_path already exists but is not the worktree for $branch; refusing to use it." >&2
            exit 1
        fi
        echo "Worktree already exists at $wt_path"
    else
        if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
            start_ref="refs/heads/$branch"
            add_args=("$wt_path" "$branch")
        else
            remote_name="origin"
            remote_branch=""
            checked_remote=false

            if ! git -C "$repo_root" remote get-url "$remote_name" >/dev/null 2>&1; then
                log "No $remote_name remote configured; creating $branch from $base_branch"
            elif [ "$no_attach" = true ]; then
                # Without a prompt, dev tree cannot ask whether to fetch, and a
                # new branch from the base would silently diverge from a
                # remote branch of the same name that is already known.
                if git -C "$repo_root" show-ref --verify --quiet "refs/remotes/$remote_name/$branch"; then
                    echo "[dev tree] $remote_name/$branch exists, and --no-attach never chooses between it and $base_branch. Run \`dev tree $branch\` interactively, or create the local branch first." >&2
                    exit 1
                fi
                log "--no-attach does not fetch $remote_name; creating $branch from $base_branch"
            elif prompt_to_check_remote_branch "$remote_name"; then
                checked_remote=true
                git -C "$repo_root" fetch "$remote_name"
                if git -C "$repo_root" show-ref --verify --quiet "refs/remotes/$remote_name/$branch"; then
                    remote_branch="$remote_name/$branch"
                fi
            fi

            if [ -n "$remote_branch" ]; then
                log "Found remote branch $remote_branch; creating local branch $branch tracking it"
                start_ref="$remote_branch"
                add_args=(--track -b "$branch" "$wt_path" "$remote_branch")
            else
                if [ "$checked_remote" = true ]; then
                    log "No remote branch $remote_name/$branch found; creating $branch from $base_branch"
                elif [ "$no_attach" = false ] && git -C "$repo_root" remote get-url "$remote_name" >/dev/null 2>&1; then
                    log "Skipped remote lookup; creating $branch from $base_branch"
                fi
                start_ref="$base_branch"
                add_args=(-b "$branch" "$wt_path" "$base_branch")
            fi
        fi

        windows="$(tmux_worktree_dev_config_windows_for_ref "$repo_root" "$start_ref" "$agent")"
        session_agent="$(tmux_worktree_dev_config_windows_for_ref "$repo_root" "$start_ref" "$agent" --selected-agent)"
        git -C "$repo_root" worktree add "${add_args[@]}"
        created_worktree=true
        if [ "${add_args[0]}" = -b ] || [ "${add_args[0]}" = --track ]; then
            created_branch=true
        fi
    fi
fi

preferred_session_name="$(tmux_worktree_preferred_worktree_session_name "$repo_name" "$branch")"
session_name="$(tmux_worktree_find_session_for_worktree_path "$wt_path" || true)"

if [ -n "$session_name" ]; then
    tmux_worktree_set_session_metadata "$session_name" "$wt_path" "$branch"
    tmux_worktree_registry adopt "$session_name" "$wt_path" "$branch"
    if [ -n "$agent" ] || [ "$stage_agent" = true ]; then
        log "Reusing session $session_name; --agent and --stage-agent apply only to new sessions (dev close it to switch)"
    fi
    finish "$session_name"
    exit 0
fi

session_name="$preferred_session_name"
if tmux has-session -t "$session_name" 2>/dev/null; then
    session_name="$(tmux_worktree_make_session_name "${preferred_session_name}-$(tmux_worktree_path_checksum "$wt_path")")"
    log "Session $preferred_session_name is already attached to another worktree; using $session_name"
fi

if [ -z "$windows" ]; then
    windows="$(tmux_worktree_dev_config_windows_for_path "$wt_path" "$agent")"
    session_agent="$(tmux_worktree_dev_config_windows_for_path "$wt_path" "$agent" --selected-agent)"
fi

if [ "$created_worktree" = true ]; then
    run_startup_script "$repo_root" "$wt_path"
fi

tmux_worktree_create_standard_session "$session_name" "$wt_path" "$branch" "" "$windows" "$stage_agent" "$session_agent"
finish "$session_name"
