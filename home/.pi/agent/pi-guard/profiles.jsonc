      "emoji": "🔥",
      "extends": ["sidecar-comments", "builtin:committer"],
      "color": "red",
      "transforms": ["transform:allow-asks"],
    },
    "mcp-git-full": {
      "description": "Git",
      "emoji": "🔥",
      "extends": ["mcp", "ruleset:git", "builtin:git-full"],
      "color": "red",
      "tools": {
        "bash": [
          {
            "pattern": "CI=true npm test -- *",
            "decision": "allow"
          },
          {
            "pattern": "CI=true npm run test:watch -- *",
            "decision": "allow"
          }
        ]
      },
    },
    "sidecar-comments-allow-asks-implement-only": {
      "description": "No test files, implementation only",
      "emoji": "✍️",
