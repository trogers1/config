{
  "$schema": "../../packages/pi-guard/schemas/profiles.schema.json",
  "defaultProfile": "mcp",
  "rulesets": {
    "flow-review": {
      // Shared, preinstalled CLI only: rendering and --validate need no install.
      "tools": {
        "bash": [
          {
            "pattern": "node ~/.agents/skills/flow-review/dist/scripts/render_flow_html.js *",
            "decision": "allow",
          },
          {
            "pattern": "node /Users/*/.agents/skills/flow-review/dist/scripts/render_flow_html.js *",
            "decision": "allow",
          },
        ],
      },
      // Bash operands use absolute path rules; ~ is not expanded in patterns.
      "writePaths": [
        {
          "pattern": "/Users/*/.agents/skills/flow-review/dist/scripts/render_flow_html.js",
          "decision": "allow",
          "contexts": ["bash"],
        },
      ],
    },
    "infra-mutation-deny": {
      "tools": {
        "bash": [
          {
            "pattern": "terraform apply*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform destroy*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform import*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform refresh*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform taint*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform untaint*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform state *",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform force-unlock*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform test*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform * apply*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "terraform * destroy*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*aws-tf apply*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*aws-tf destroy*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*auth0-tf apply*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*auth0-tf destroy*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/activate-env*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/apply*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/deploy*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/destroy-preview*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/init-env*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
          {
            "pattern": "*scripts/infra/sync-secrets*",
            "decision": "deny",
            "guidance": "Infrastructure mutations are disabled in custom profiles. Do not change real infrastructure through Terraform, its wrappers, or infrastructure orchestrators.",
          },
        ],
      },
    },
    "config-symlink-boundaries": {
      "readPaths": [
        {
          "pattern": "/Users/*/.pi/agent/packages",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/packages/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/usage",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/usage/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/pi-guard",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/pi-guard/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
        },
      ],
      "writePaths": [
        {
          "pattern": "/Users/*/.pi/agent/packages",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/packages/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/usage",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/usage/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/pi-guard",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
        {
          "pattern": "/Users/*/.pi/agent/pi-guard/**",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Write to the source under home/.pi/agent/... instead.",
        },
      ],
    },
  },
  "profiles": {
    "config-maintenance": {
      "description": "Configuration maintenance profile for the Pi setup repository.",
      "extends": [
        "builtin:default",
        "ruleset:vitest",
        "customruleset:infra-mutation-deny",
        "customruleset:config-symlink-boundaries",
      ],
      "sandbox": false,
      "directoryGlobs": ["~/Code/config", "~/code/config"],
      "readPaths": [
        {
          "pattern": "/Users/*/.nvm/versions/**/lib/node_modules/@earendil-works/pi-coding-agent/**",
          "decision": "allow",
        },
        {
          "pattern": "/var/folders/pc/*/T/*", // mac temp dir
          "decision": "allow",
        },
        {
          "pattern": "~/.pi",
          "decision": "deny",
          "guidance": "There's no reason to read from ~. The local files at ./home/.pi/ are symlinked to there",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/**/open_source/*",
          "decision": "allow",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/**/open_source/**",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/.nvm/versions/node/v24.15.0/lib/node_modules/@earendil-works/*",
          "decision": "allow",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/.nvm/versions/node/v24.15.0/lib/node_modules/@earendil-works",
          "decision": "allow",
          "contexts": ["ls"],
        },
        {
          "pattern": "/var/folders/pc/*/T/**",
          "decision": "allow",
        },
        {
          "pattern": "/dev/null",
          "decision": "allow",
        },
        {
          "pattern": "~/**/open_source/pi-interactive-subagents/**",
          "decision": "allow",
          "contexts": ["grep"],
        },
        {
          "pattern": "~/**/config/.pi/orchestration/*",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/config/.agents/**",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/config/.pi/**",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/config/.pi/**",
          "decision": "allow",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/**/config/home/.pi/agent/*",
          "decision": "deny",
          "guidance": "Those files are symlinks to the real ones at ./home/.pi",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/config/home/.pi/agent/pi-guard/profiles.jsonc",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/sidecar-comments/**",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "~/**/sidecar-comments",
          "decision": "allow",
          "contexts": ["ls"],
        },
      ],
      "writePaths": [
        {
          "pattern": "/Users/*/Code/config/**",
          "decision": "allow",
        },
        {
          "pattern": "/Users/*/code/config/**",
          "decision": "allow",
        },
        {
          "pattern": "/var/folders/pc/*/T/*", // mac temp dir
          "decision": "allow",
        },
        {
          "pattern": "~/.nvm/versions/node/v24.15.0/lib/node_modules/@earendil-works/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "/var/folders/pc/*/T/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "/dev/null",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "~/**/sidecar-comments/**",
          "decision": "allow",
          "contexts": ["write"],
        },
      ],
      "tools": {
        "bash": [
          {
            "pattern": "npx prettier --check *",
            "decision": "deny",
            "guidance": "Use `npm run prettier:fix` instead of checking.",
          },
          {
            "pattern": "npx vitest run *",
            "decision": "deny",
            "guidance": "Use `npm test` and `npm test -- <file>` instead",
          },
          {
            "pattern": "npx tsc --noEmit",
            "decision": "allow",
          },
          {
            "pattern": "npm root -g",
            "decision": "allow",
          },
          {
            "pattern": "npx prettier --write *",
            "decision": "deny",
            "guidance": "Just use `npm run fix:prettier`",
          },
          {
            "pattern": "./node_modules/.bin/prettier *",
            "decision": "deny",
            "guidance": "Use `npm run prettier:fix` or `npm run fix:prettier`",
          },
          {
            "pattern": "npx vitest",
            "decision": "deny",
            "guidance": "Use npm test instead",
          },
          {
            "pattern": "node_modules/prettier/bin/prettier.cjs",
            "decision": "deny",
            "guidance": "Use npm run fix:prettier",
          },
          {
            "pattern": "node_modules/prettier/bin/prettier.cjs *",
            "decision": "deny",
            "guidance": "Use npm run fix:prettier",
          },
          {
            "pattern": "npx tsc",
            "decision": "deny",
            "guidance": "Use npm run check:all",
          },
          {
            "pattern": "npx tsc *",
            "decision": "deny",
            "guidance": "Use npm run check:all",
          },
          {
            "pattern": "npx prettier *",
            "decision": "deny",
            "guidance": "Use npm run fix:prettier",
          },
          {
            "pattern": "npx vitest *",
            "decision": "deny",
            "guidance": "Just use `npm test -- `",
          },
          {
            "pattern": "npm * --ignore-scripts *",
            "decision": "deny",
            "guidance": "Do not use --ignore-scripts",
          },
          {
            "pattern": "npm --ignore-scripts test *",
            "decision": "deny",
            "guidance": "Do not use --ignore-scripts",
          },
          {
            "pattern": "./node_modules/.bin/vitest *",
            "decision": "deny",
            "guidance": "Just use `npm test --` instead",
          },
          {
            "pattern": "node -e * prettier *",
            "decision": "deny",
            "guidance": "Just use `npm run fix:prettier` to format",
          },
          {
            "pattern": "printf *",
            "decision": "allow",
          },
          {
            "pattern": "node --version",
            "decision": "allow",
          },
          {
            "pattern": "npm --version",
            "decision": "allow",
          },
          {
            "pattern": "echo *",
            "decision": "allow",
          },
          {
            "pattern": "prettier --write *",
            "decision": "deny",
            "guidance": "Just use `npm run fix:prettier`",
          },
          {
            "pattern": "* CI=1 *",
            "decision": "deny",
            "guidance": "You're not in CI, do not set that env var",
          },
          {
            "pattern": "home/.pi/agent/packages/pi-guard/node_modules/.bin/vitest *",
            "decision": "deny",
            "guidance": "Just use `npm test` or `npm test -- <file>`",
          },
          {
            "pattern": "CI=1 *",
            "decision": "deny",
            "guidance": "You're not in CI, so don't set that env var",
          },
          {
            "pattern": "**/node_modules/.bin/prettier *",
            "decision": "deny",
            "guidance": "Just use `npm run fix:prettier`",
          },
          {
            "pattern": "npm --prefix home/.pi/agent/packages/* run fix:prettier",
            "decision": "allow",
          },
          {
            "pattern": "npm --prefix home/.pi/agent/packages/* run *",
            "decision": "allow",
          },
          {
            "pattern": "cp *",
            "decision": "allow",
          },
          {
            "pattern": "mv *",
            "decision": "allow",
          },
          {
            "pattern": "pi --version",
            "decision": "allow",
          },
          {
            "pattern": "bash tests/**",
            "decision": "allow"
          },
          {
            "pattern": "bash -n **",
            "decision": "allow"
          },
          {
            "pattern": "python3 tests/**",
            "decision": "allow"
          },
          {
            "pattern": "pi --help",
            "decision": "allow"
          },
          {
            "pattern": "claude --help",
            "decision": "allow"
          },
          {
            "pattern": "-v *",
            "decision": "allow"
          },
          {
            "pattern": "jira-ticket *",
            "decision": "allow"
          },
        ],
      },
    },
    "config-maintenance-tests-hidden": {
      "description": "Configuration maintenance with tests hidden from the agent.",
      "extends": [
        "builtin:tests-hidden",
        "ruleset:vitest",
        "customruleset:infra-mutation-deny",
        "customruleset:config-symlink-boundaries",
      ],
      "sandbox": {
        "network": "deny",
        "extraWritePaths": ["~/.local/state/dev"],
        // Tests remain denied to agent tools by builtin:tests-hidden, but the
        // test runner must be able to load them from its sandboxed process.
        "kernelUnenforcedProtectedPaths": [
          "**/test",
          "**/test/**",
          "**/tests",
          "**/tests/**",
          "**/__tests__",
          "**/__tests__/**",
          "**/integrationTests",
          "**/integrationTests/**",
          "**/*.test.*",
          "**/*.spec.*",
          "**/*_test.*",
          "**/*.cy.*",
        ],
      },
      "readPaths": [
        {
          "pattern": "/Users/*/.nvm/versions/**/lib/node_modules/@earendil-works/pi-coding-agent/**",
          "decision": "allow",
        },
      ],
    },
    "config-maintenance-tests-only": {
      "description": "Configuration maintenance restricted to test-file changes.",
      "extends": [
        "builtin:tests-only",
        "ruleset:vitest",
        "customruleset:infra-mutation-deny",
        "customruleset:config-symlink-boundaries",
      ],
      "sandbox": {
        "network": "deny",
        "extraWritePaths": ["~/.local/state/dev"],
      },
      "readPaths": [
        {
          "pattern": "/Users/*/.nvm/versions/**/lib/node_modules/@earendil-works/pi-coding-agent/**",
          "decision": "allow",
        },
      ],
    },
    "gitlab-skills": {
      "description": "GitLab skill scripts with network access and gate-only .git access for merge-request workflows.",
      "extends": ["builtin:default-with-net"],
      "sandbox": {
        "extraWritePaths": ["~/.local/state/dev"],
      },
      "tools": {
        "bash": [
          // These installed helpers only read GitLab; refresh/render can write
          // local exports, which remain subject to ordinary path permissions.
          // Name each trusted script explicitly: never allow a wildcard script
          // name or a copied helper elsewhere in the filesystem.
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/refresh-robot-comments-md.sh *",
            "decision": "allow",
          },
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/refresh-all-comments-md.sh *",
            "decision": "allow",
          },
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/fetch-mr-discussions.sh *",
            "decision": "allow",
          },
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/enrich-discussions.sh *",
            "decision": "allow",
          },
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/render-comments-md.sh *",
            "decision": "allow",
          },
          // preview-replies.sh rejects every flag after shell expansion, so it
          // can never write. Patterns match raw command text (`--po''st` would
          // slip past a `*--post*` rule), so the write-capable post-replies.sh
          // always asks whatever its arguments. Both are anchored to the
          // installed path so a copy elsewhere is not trusted.
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/preview-replies.sh *",
            "decision": "allow",
          },
          {
            "pattern": "bash ~/.agents/skills/address-comments/scripts/post-replies.sh *",
            "decision": "ask",
            "guidance": "This can post replies to GitLab MR threads. Run preview-replies.sh first, show Taylor the full preview, and only run post-replies.sh --post after explicit approval in chat.",
          },
        ],
      },
      "readPaths": [
        {
          "pattern": "/**/home/.pi/agent/packages/**",
          "decision": "allow",
        },
      ],
      "writePaths": [
        {
          "pattern": "/**/home/.pi/agent/packages/**",
          "decision": "allow",
        },
        {
          "pattern": "/**/home/.agents/skills/address-comments/scripts/*.sh",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "/**/.agents/skills/address-comments/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
      ],
    },
    "mcp": {
      "description": "MCP default profile with local coding workflow guardrails.",
      "extends": [
        "builtin:default",
        "ruleset:vitest",
        "customruleset:infra-mutation-deny",
        "gitlab-skills",
        "customruleset:flow-review",
      ],
      "sandbox": {
        "network": "allow",
        "allowAppleEvents": true,
        "extraWritePaths": [
          "/var/folders/*/*/T/**",
          "~/.local/share/lightcast-mcp/tokens/**",
          // dev writes locks, recovery records, and atomic-replacement temp files.
          "~/.local/state/dev",
        ],
        // Full kernel waivers, not Git-only or read-only exceptions: approved
        // child processes can read these files and write within writable roots.
        // Direct tool/path requests remain protected by the permission gate.
        "kernelUnenforcedProtectedPaths": [
          "**/.env*",
          "**/.git",
          "**/.git/**",
          "**/.npmrc",
          "**/*.tfvars",
        ],
      },
      "tools": {
        "bash": [
          {
            "pattern": "npx prettier",
            "decision": "deny",
            "guidance": "Do not invoke Prettier through npx. Use the repository's configured formatter or make targeted edits with Pi's edit tool.",
            "alternatives": [
              "npm run prettier:write",
              "npm run fix:prettier",
              "Use the edit tool for targeted changes",
            ],
          },
          {
            "pattern": "npx prettier *",
            "decision": "deny",
            "guidance": "Do not invoke Prettier through npx. Use the repository's configured formatter or make targeted edits with Pi's edit tool.",
            "alternatives": [
              "npm run prettier:write",
              "npm run fix:prettier",
              "Use the edit tool for targeted changes",
            ],
          },
          {
            "pattern": "**/node_modules/.bin/*",
            "decision": "deny",
            "guidance": "Do not invoke packages directly. Use the repository's configured scripts.",
            "alternatives": [
              "npm run prettier:write",
              "npm run fix:prettier",
              "npm test",
              "Use the edit tool to add needed scripts to package.json (or equivalent)",
            ],
          },
          {
            "pattern": "npx vitest",
            "decision": "deny",
            "guidance": "Do not invoke Vitest through npx. Inspect package.json and use the repository's configured test script instead.",
            "alternatives": [
              "npm test",
              "npm test -- <requested test filters>",
            ],
          },
          {
            "pattern": "npx vitest *",
            "decision": "deny",
            "guidance": "Do not invoke Vitest through npx. Inspect package.json and use the repository's configured test script instead.",
            "alternatives": ["npm test -- <requested test filters>"],
          },
          {
            "pattern": "env",
            "decision": "deny",
            "guidance": "You don't need to check that. Ask if you need anything specific.",
          },
          {
            "pattern": "docker version",
            "decision": "allow",
          },
          {
            "pattern": "docker info *",
            "decision": "allow",
          },
          {
            "pattern": "echo *",
            "decision": "allow",
          },
          {
            "pattern": "docker context *",
            "decision": "allow",
          },
          {
            "pattern": "printf *",
            "decision": "allow",
          },
          {
            "pattern": "nvm use",
            "decision": "allow",
          },
          {
            "pattern": "* npx vitest run *",
            "decision": "deny",
            "guidance": "Use `npm test -- <files>` instead",
          },
          {
            "pattern": "node ~/.agents/skills/** *",
            "decision": "allow",
          },
          {
            "pattern": "-v jiratui",
            "decision": "allow",
          },
          // Require approval for the general Jira clients; save narrower
          // allow/deny decisions as needed. jira-ticket keeps its own rules.
          {
            "pattern": "jira",
            "decision": "ask",
          },
          {
            "pattern": "jira *",
            "decision": "ask",
          },
          {
            "pattern": "jiratui",
            "decision": "ask",
          },
          {
            "pattern": "jiratui *",
            "decision": "ask",
          },
          {
            "pattern": "jira-ticket *",
            "decision": "allow",
          },
          {
            "pattern": "-v terraform",
            "decision": "allow",
          },
          {
            "pattern": "node --version",
            "decision": "allow",
          },
          {
            "pattern": "-v jira-ticket",
            "decision": "allow",
          },
          {
            "pattern": "dev tree *",
            "decision": "allow"
          },
          {
            "pattern": "-v dev",
            "decision": "allow"
          },
          {
            "pattern": "pg_dump --version",
            "decision": "allow"
          },
          {
            "pattern": "psql --version",
            "decision": "allow"
          },
          {
            "pattern": "dev *",
            "decision": "allow"
          },
          {
            "pattern": "git symbolic-ref --quiet --short HEAD",
            "decision": "allow"
          },
          {
            "pattern": "git check-ref-format --branch *",
            "decision": "allow"
          },
        ],
      },
      "readPaths": [
        {
          "pattern": "/var/folders/pc/*/T/**",
          "decision": "allow",
          "contexts": ["grep"],
        },
        {
          "pattern": "~/.pi/agent/packages/pi-guard",
          "decision": "deny",
          "guidance": "Just update local files within this project (they should be symlinked in the setup scripts)",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/.pi/agent/packages/pi-guard-subagents",
          "decision": "deny",
          "guidance": "Just update local files within this project (they should be symlinked in the setup scripts)",
          "contexts": ["ls"],
        },
        {
          "pattern": "~/Documents/bruno/**",
          "decision": "allow",
          "contexts": ["read"],
        },
        {
          "pattern": "/Users/taylor.rogers/bin/dev",
          "decision": "allow",
          "contexts": [
            "read"
          ]
        },
        {
          "pattern": "/Users/taylor.rogers/bin/dev *",
          "decision": "allow",
          "contexts": [
            "read"
          ]
        },
        {
          "pattern": "/Users/taylor.rogers/Code/config/tmux_and_worktrees/bin/**",
          "decision": "allow",
          "contexts": [
            "read"
          ]
        },
        {
          "pattern": "/Users/taylor.rogers/.pi/**",
          "decision": "allow",
          "contexts": [
            "read"
          ]
        },
      ],
      "writePaths": [
        {
          "pattern": "/dev/null",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "~/.agents/skills/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "~/Documents/bruno/**",
          "decision": "allow",
          "contexts": ["write"],
        },
        {
          "pattern": "~/Documents/bruno/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
        {
          "pattern": "~/.local/share/lightcast-mcp/tokens/**",
          "decision": "allow",
          "contexts": ["bash"],
        },
      ],
    },
    "performance-review": {
      "description": "Performance review profile with GitHub and GitLab access.",
      "extends": ["builtin:default", "customruleset:infra-mutation-deny"],
      "sandbox": {
        "network": "allow",
        "extraWritePaths": ["~/.local/state/dev"],
      },
      "color": "red",
      "emoji": "📋",
      "tools": {
        "bash": [
          {
            "pattern": "glab *",
            "decision": "allow",
          },
          {
            "pattern": "gh *",
            "decision": "allow",
          },
          {
            "pattern": "jq *",
            "decision": "allow",
          },
        ],
      },
    },
    "socrates": {
      "description": "Read-only Socratic coaching profile.",
      "extends": ["builtin:read-only", "customruleset:infra-mutation-deny"],
      "sandbox": {
        "extraWritePaths": ["~/.local/state/dev"],
      },
      "promptFile": "~/.pi/agent/pi-guard/prompts/socrates.md",
      "color": "cyan",
      "emoji": "🧠",
    },
    "sidecar-comments": {
      "description": "Sidecar-specific profile (can see config repo)",
      "emoji": "🛵",
      "extends": ["mcp", "ruleset:go-runtime-commands"],
      "directoryGlobs": ["~/**/sidecar-comments"],
      "color": "yellow",
      "tools": {
        "bash": [
          
          
          {
            "pattern": "make *",
            "decision": "allow",
          },
          
          {
            "pattern": "GOTOOLCHAIN=local go test *",
            "decision": "allow",
          },
          {
            "pattern": "SIDECAR_BIN=\"$PWD/bin/sidecar\" go test *",
            "decision": "allow",
          },
        ],
      },
    },
    "sidecar-comments-allow-asks": {
      "description": "Sidecar-comments Golang profile for auto-pilot that allows asks",
      "emoji": "🤖",
      "extends": ["sidecar-comments"],
      "color": "orange",
      "transforms": ["transform:allow-asks"],
    },
    "personal-sidecar-comments-deny-asks": {
      "description": "Auto-pilot extension to the golang sidecar profile that denies asks",
      "emoji": "🚅",
      "extends": ["sidecar-comments-allow-asks"],
      "color": "green",
      "transforms": ["transform:deny-asks"],
    },
    "mcp-worktrees": {
      "description": "MCP workspace management with shared Git metadata and sibling-worktree write access.",
      "emoji": "🌳",
      "extends": ["mcp"],
      "color": "yellow",
      "sandbox": {
        "extraWritePaths": [
          "~/Code/mcp/.git",
          "~/Code/mcp-worktrees",
        ],
      },
    },
    "mcp-deny-asks": {
      "description": "The conservative auto-pilot for the MCP profile.",
      "emoji": "👨‍✈️",
      "extends": ["mcp"],
      "color": "green",
      "transforms": ["transform:deny-asks"],
    },
    "personal-allow-asks": {
      "description": "Dangerous auto-pilot for the MCP profile",
      "emoji": "🔥",
