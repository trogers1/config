      "color": "red",
      "transforms": ["transform:allow-asks"],
    },
    "config-maintenance-allow-asks": {
      "description": "Auto-pilot",
      "emoji": "🔥",
      "extends": ["config-maintenance"],
      "transforms": ["transform:allow-asks"],
      "color": "red",
    },
    "config-maintenance-deny-asks": {
      "description": "Safer auto-pilot",
      "emoji": "🚅",
      "extends": ["config-maintenance"],
      "color": "green",
      "transforms": ["transform:deny-asks"],
