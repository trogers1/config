        "ruleset:deps-mutations-allow",
      ],
      "color": "red",
    },
    "mcp-committer": {
      "description": "MCP git-commit capable",
      "emoji": "✍️",
      // The command-only git-commit rule set does not grant sandbox writes
      // to a linked worktree's shared metadata outside its startup directory.
      "extends": ["mcp", "builtin:committer", "ruleset:git-refs"],
      "sandbox": {
        // Preserve MCP networking; builtin:committer otherwise selects deny.
        "network": "allow",
      },
      "color": "yellow",
    },
    "mcp-allow-asks": {
      "description": "mcp auto-pilot that allows asks",
      "emoji": "🔥",
      "extends": ["mcp"],
      "color": "red",
      "transforms": ["transform:allow-asks"],
      "directoryGlobs": ["~/**/mcp"],
    },
    "sidecar-comments-committer-allow-asks": {
