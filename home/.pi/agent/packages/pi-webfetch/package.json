{
  "name": "taylor-pi-webfetch",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "check:sdk": "node ../check-pi-sdk.mjs",
    "check:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext extensions/webfetch.ts",
    "check:all": "npm run check:sdk && npm run check:types"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "dependencies": {
    "playwright": "^1.54.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "typebox": "1.3.27",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
