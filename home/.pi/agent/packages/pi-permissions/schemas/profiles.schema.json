{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "defaultProfile": { "type": "string" },
    "profiles": {
      "type": "object",
      "patternProperties": {
        "^(?!builtin:).+$": {
          "type": "object",
          "properties": {
            "promptFile": {
              "anyOf": [{ "type": "string" }, { "type": "null" }]
            },
            "color": {
              "anyOf": [
                { "type": "string", "const": "black" },
                { "type": "string", "const": "red" },
                { "type": "string", "const": "green" },
                { "type": "string", "const": "yellow" },
                { "type": "string", "const": "blue" },
                { "type": "string", "const": "magenta" },
                { "type": "string", "const": "cyan" },
                { "type": "string", "const": "white" }
              ]
            },
            "emoji": { "type": "string" },
            "directories": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "tools": {
              "type": "object",
              "properties": {
                "bash": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pattern", "decision"],
                    "properties": {
                      "pattern": { "type": "string" },
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "patternProperties": {
                "^(?!(?:bash|read|grep|find|ls|edit|write)$).+$": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["decision"],
                    "properties": {
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "match": {
                        "type": "object",
                        "patternProperties": { "^.+$": { "type": "string" } },
                        "additionalProperties": false,
                        "minProperties": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "readPaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "read" },
                        { "type": "string", "const": "grep" },
                        { "type": "string", "const": "find" },
                        { "type": "string", "const": "ls" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "writePaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "edit" },
                        { "type": "string", "const": "write" },
                        { "type": "string", "const": "bash" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "protectedPathPatterns": {
              "type": "array",
              "items": { "type": "string" }
            },
            "protectedPathExceptions": {
              "type": "array",
              "items": { "type": "string" }
            },
            "extends": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://earendil.works/pi-permissions/profiles.schema.json",
  "title": "pi-permissions profile configuration",
  "additionalProperties": false
}
