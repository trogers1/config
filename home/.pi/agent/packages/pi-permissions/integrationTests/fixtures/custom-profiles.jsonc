{
  "$schema": "https://earendil.works/pi-permissions/profiles.schema.json",
  "profiles": {
    "review-tools": {
      "extends": "default",
      "directories": ["/workspace"],
      "tools": {
        "bash": [
          { "pattern": "glab *", "decision": "allow" },
          { "pattern": "gh *", "decision": "allow" },
        ],
      },
    },
    // Deliberately collides with a shipped profile name to prove that user
    // configuration replaces the built-in definition.
    "read-only": {
      "extends": "default",
      "tools": {
        "bash": [{ "pattern": "fixture-only *", "decision": "allow" }],
      },
    },
    "address-comments": {
      "extends": "default",
      "directories": ["/workspace"],
      "tools": {
        "bash": [{ "pattern": "git commit -m *", "decision": "allow" }],
      },
    },
    "protected-matrix": {
      "extends": "default",
      "readPaths": [{ "pattern": "private/**", "decision": "ask" }],
      "writePaths": [{ "pattern": "private/**", "decision": "ask" }],
      "protectedPathPatterns": ["**/.env*"],
      "protectedPathExceptions": ["**/.env.template"],
    },
  },
}
