{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "defaultProfile": { "type": "string" },
    "rulesets": {
      "type": "object",
      "patternProperties": {
        "^.+$": {
          "type": "object",
          "properties": {
            "tools": {
              "type": "object",
              "properties": {
                "bash": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pattern", "decision"],
                    "properties": {
                      "pattern": { "type": "string" },
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "patternProperties": {
                "^(?!(?:bash|read|grep|find|ls|edit|write)$).+$": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["decision"],
                    "properties": {
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "match": {
                        "type": "object",
                        "patternProperties": { "^.+$": { "type": "string" } },
                        "additionalProperties": false,
                        "minProperties": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "readPaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "read" },
                        { "type": "string", "const": "grep" },
                        { "type": "string", "const": "find" },
                        { "type": "string", "const": "ls" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "writePaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "edit" },
                        { "type": "string", "const": "write" },
                        { "type": "string", "const": "bash" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1
            },
            "protectedPathRules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "minProperties": 1
        }
      },
      "additionalProperties": false
    },
    "profiles": {
      "type": "object",
      "patternProperties": {
        "^(?!(?:builtin:|ruleset:|customruleset:|transform:)).+$": {
          "type": "object",
          "required": ["description"],
          "properties": {
            "description": { "type": "string", "minLength": 1 },
            "promptFile": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "pattern": "^(?:/.+|~/.+)$",
                  "description": "An absolute path or a path beginning with ~/. Relative paths are reserved for shipped profiles."
                },
                { "type": "null" }
              ]
            },
            "color": {
              "anyOf": [
                { "type": "string", "const": "black" },
                { "type": "string", "const": "red" },
                { "type": "string", "const": "green" },
                { "type": "string", "const": "yellow" },
                { "type": "string", "const": "orange" },
                { "type": "string", "const": "blue" },
                { "type": "string", "const": "magenta" },
                { "type": "string", "const": "cyan" },
                { "type": "string", "const": "white" }
              ]
            },
            "emoji": { "type": "string" },
            "tools": {
              "type": "object",
              "properties": {
                "bash": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["pattern", "decision"],
                    "properties": {
                      "pattern": { "type": "string" },
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "patternProperties": {
                "^(?!(?:bash|read|grep|find|ls|edit|write)$).+$": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["decision"],
                    "properties": {
                      "decision": {
                        "anyOf": [
                          { "type": "string", "const": "allow" },
                          { "type": "string", "const": "ask" },
                          { "type": "string", "const": "deny" }
                        ]
                      },
                      "guidance": { "type": "string" },
                      "alternatives": {
                        "type": "array",
                        "items": { "type": "string" }
                      },
                      "match": {
                        "type": "object",
                        "patternProperties": { "^.+$": { "type": "string" } },
                        "additionalProperties": false,
                        "minProperties": 1
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "readPaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "read" },
                        { "type": "string", "const": "grep" },
                        { "type": "string", "const": "find" },
                        { "type": "string", "const": "ls" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "writePaths": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "ask" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" },
                  "alternatives": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "contexts": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        { "type": "string", "const": "edit" },
                        { "type": "string", "const": "write" },
                        { "type": "string", "const": "bash" }
                      ]
                    },
                    "minItems": 1,
                    "uniqueItems": true
                  }
                },
                "additionalProperties": false
              }
            },
            "protectedPathRules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["pattern", "decision"],
                "properties": {
                  "pattern": { "type": "string" },
                  "decision": {
                    "anyOf": [
                      { "type": "string", "const": "allow" },
                      { "type": "string", "const": "deny" }
                    ]
                  },
                  "guidance": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "sandbox": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "network": {
                      "anyOf": [
                        { "type": "string", "const": "allow" },
                        { "type": "string", "const": "deny" }
                      ]
                    },
                    "extraWritePaths": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "extraDenyReadPaths": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "extraDenyWritePaths": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "kernelUnenforcedProtectedPaths": {
                      "type": "array",
                      "items": { "type": "string", "minLength": 1 }
                    },
                    "enableWeakerNetworkIsolation": {
                      "type": "boolean",
                      "description": "Permits macOS trustd IPC for Go TLS verification. This weakens network isolation and can permit data exfiltration; see https://github.com/anthropic-experimental/sandbox-runtime#security-limitations."
                    },
                    "allowLocalBinding": {
                      "type": "boolean",
                      "description": "Permits local Unix-domain and loopback socket listeners while network access remains denied."
                    },
                    "allowAppleEvents": {
                      "type": "boolean",
                      "description": "Permits macOS Apple Events and LaunchServices handoffs (for example the open command) from sandboxed Bash."
                    },
                    "onUnavailable": {
                      "anyOf": [
                        { "type": "string", "const": "block" },
                        { "type": "string", "const": "warn" }
                      ]
                    },
                    "overwritePathArrays": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          { "type": "string", "const": "extraWritePaths" },
                          { "type": "string", "const": "extraDenyReadPaths" },
                          { "type": "string", "const": "extraDenyWritePaths" },
                          {
                            "type": "string",
                            "const": "kernelUnenforcedProtectedPaths"
                          }
                        ]
                      },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                },
                { "type": "boolean", "const": false }
              ]
            },
            "directoryGlobs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?:~|/|(?:~/|/)(?!.*\\*{3})(?:\\*\\*|(?!(?:\\.{1,2})(?:/|$))(?!(?:[^/]*\\*\\*))[^\\\\/\\u0000-\\u001f\\u007f~\\[\\]{}()!+|^$]+)(?:/(?:\\*\\*|(?!(?:\\.{1,2})(?:/|$))(?!(?:[^/]*\\*\\*))[^\\\\/\\u0000-\\u001f\\u007f~\\[\\]{}()!+|^$]+))*)$"
              },
              "minItems": 1,
              "maxItems": 128,
              "uniqueItems": true
            },
            "extends": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "transforms": {
              "type": "array",
              "items": {
                "anyOf": [
                  { "type": "string", "const": "transform:deny-asks" },
                  { "type": "string", "const": "transform:allow-asks" },
                  { "type": "string", "const": "transform:ask-all" },
                  { "type": "string", "const": "transform:deny-all" }
                ]
              }
            }
          },
          "additionalProperties": false,
          "dependentRequired": { "transforms": ["extends"] }
        }
      },
      "additionalProperties": false
    }
  },
  "$id": "https://raw.githubusercontent.com/trogers1/config/main/home/.pi/agent/packages/pi-guard/schemas/profiles.schema.json",
  "title": "pi-guard profile configuration",
  "additionalProperties": false
}
