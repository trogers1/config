{
  "name": "@trogers1/pi-claude",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Locally owned Pi provider using the official Claude Agent SDK",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "piCompatibility": {
    "minimumVersion": "0.99.1"
  },
  "scripts": {
    "check:all": "npm run check:types && npm run check:lint && npm run check:deps && npm run check:knip && npm run check:prettier",
    "check:types": "node tests/check-types.mjs",
    "check:lint": "eslint .",
    "check:deps": "depcruise extensions tests vitest.config.ts --config .dependency-cruiser.cjs",
    "check:knip": "knip",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write",
    "pretest": "npm run check:all",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.293",
    "@modelcontextprotocol/sdk": "1.31.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@types/node": "^26.1.1",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "knip": "^6.29.0",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
