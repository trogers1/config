    "config-maintenance-tests-only": {
      "description": "Configuration maintenance restricted to test-file changes.",
      "extends": ["builtin:tests-only"],
      "sandbox": { "network": "deny" },
      "readPaths": [
        {
          "pattern": "/Users/*/.pi/agent/packages",
          "decision": "deny",
          "guidance": "Pi packages/settings here are symlinks to this configuration checkout. Read the source under home/.pi/agent/... instead.",
